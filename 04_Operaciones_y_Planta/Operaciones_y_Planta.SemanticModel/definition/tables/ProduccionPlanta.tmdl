					Tipos = Table.TransformColumnTypes(Encabezados, {{"RemitoID", type text}, {"DateKey", Int64.Type}, {"Fecha", type date}, {"CentroCostoID", type text}, {"VariedadUva", type text}, {"FincaOrigen", type text}, {"KilosEntrada", type number}, {"GradosBrix", type number}, {"LitrosMostoObtenido", type number}, {"RendimientoExtraccionPct", type number}, {"CalificacionSanitaria", type text}, {"UbicacionGeografica", type text}, {"Latitud", type number}, {"Longitud", type number}}, "en-US")
				in
					Tipos

