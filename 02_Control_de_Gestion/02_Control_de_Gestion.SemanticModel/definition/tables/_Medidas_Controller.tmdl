		lineageTag: e23388f1-54a0-4035-8707-4acf17b84440

	measure 'Desvio Costo Unitario' = [Costo Unitario Real] - [Costo Unitario Presupuesto]
		formatString: +$#,##0.00;-$#,##0.00;"-"
		displayFolder: 02 Costos y Margen Bruto
		lineageTag: 68297432-6478-4bca-9d34-e99f874c0a73

	measure 'Margen Bruto Real' = [Ingresos Reales] - [Costo Real]
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 02 Costos y Margen Bruto
		lineageTag: ce5438ff-6502-47ce-9c7b-b4ca8b3efcf9

	measure 'Margen Bruto Presupuesto' = [Ingresos Presupuesto] - [Costo Presupuesto]
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 02 Costos y Margen Bruto
		lineageTag: 3c1158e4-5eda-492b-a11a-ac0dfd40275f

	measure 'Desvio Margen Bruto Total' = [Margen Bruto Real] - [Margen Bruto Presupuesto]
		formatString: +$#,##0;-$#,##0;"-"
		displayFolder: 02 Costos y Margen Bruto
		lineageTag: 6c68fdf6-9ea6-428a-a771-64922861aa65

	measure 'Margen Bruto % Real' = DIVIDE([Margen Bruto Real], [Ingresos Reales], 0)
		formatString: 0.00%
		displayFolder: 02 Costos y Margen Bruto
		lineageTag: ff9cd798-03f0-43cf-a5c9-afd7c1a1b5a1

	measure 'Margen Bruto % Presupuesto' = DIVIDE([Margen Bruto Presupuesto], [Ingresos Presupuesto], 0)
		formatString: 0.00%
		displayFolder: 02 Costos y Margen Bruto
		lineageTag: 556598e1-4908-4b7d-95ce-dc547f041512

	measure 'Desvio Margen Bruto %' = [Margen Bruto % Real] - [Margen Bruto % Presupuesto]
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: 02 Costos y Margen Bruto
		lineageTag: 0ff5752a-349e-4138-ab8e-ce520222c322

	measure 'Efecto Volumen (EV)' =
			SUMX(
				VALUES(Productos[ProductoID]),
				VAR Q_Real = [Volumen Real]
				VAR Q_Plan = [Volumen Presupuesto]
				VAR P_Plan = DIVIDE([Ingresos Presupuesto], [Volumen Presupuesto], 0)
				VAR C_Plan = DIVIDE([Costo Presupuesto], [Volumen Presupuesto], 0)
				RETURN (Q_Real - Q_Plan) * (P_Plan - C_Plan)
			)
		formatString: +$#,##0;-$#,##0;"-"
		displayFolder: 03 Variance Analysis (Desvios)
		lineageTag: 05dfa4fe-bb89-4bbd-89b4-fe686d137667

	measure 'Efecto Precio (EP)' =
			SUMX(
				VALUES(Productos[ProductoID]),
				VAR Q_Real = [Volumen Real]
				VAR P_Real = DIVIDE([Ingresos Reales], [Volumen Real], 0)
				VAR P_Plan = DIVIDE([Ingresos Presupuesto], [Volumen Presupuesto], 0)
				RETURN Q_Real * (P_Real - P_Plan)
			)
		formatString: +$#,##0;-$#,##0;"-"
		displayFolder: 03 Variance Analysis (Desvios)
		lineageTag: 7e4e2348-17df-4ac7-931f-e86c67187863

	measure 'Efecto Costo (EC)' =
			SUMX(
				VALUES(Productos[ProductoID]),
				VAR Q_Real = [Volumen Real]
				VAR C_Real = DIVIDE([Costo Real], [Volumen Real], 0)
				VAR C_Plan = DIVIDE([Costo Presupuesto], [Volumen Presupuesto], 0)
				RETURN Q_Real * (C_Plan - C_Real)
			)
		formatString: +$#,##0;-$#,##0;"-"
		displayFolder: 03 Variance Analysis (Desvios)
		lineageTag: a95d99ec-6c13-44ce-939b-1fe41bf0ed87

	measure 'Suma Efectos Totales' = [Efecto Volumen (EV)] + [Efecto Precio (EP)] + [Efecto Costo (EC)]
		formatString: +$#,##0;-$#,##0;"-"
		displayFolder: 03 Variance Analysis (Desvios)
		lineageTag: d491bf26-9933-4dc2-8d2f-fe4af07ea67b

	measure 'Verificacion Desvio Cuadrado' = ROUND([Desvio Margen Bruto Total] - [Suma Efectos Totales], 2)
		formatString: $#,##0.00;($#,##0.00);"-"
		displayFolder: 03 Variance Analysis (Desvios)
		lineageTag: a83d539d-4263-4f87-830c-bd639212e94a

	measure 'Estado Cuadratura' = IF(ROUND([Verificacion Desvio Cuadrado], 2) = 0, "CUADRATURA EXACTA ($0.00)", "DESCUADRE DETECTADO")
		displayFolder: 03 Variance Analysis (Desvios)
		lineageTag: 5e438731-6fa9-47c4-aa8c-6bfd19669172

	measure 'Cascada Desglose Valor' =
			SWITCH(
				SELECTEDVALUE(DesgloseCascada[Orden]),
				1, [Margen Bruto Presupuesto],
				2, [Efecto Volumen (EV)],
				3, [Efecto Precio (EP)],
				4, [Efecto Costo (EC)],
				BLANK()
			)
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 03 Variance Analysis (Desvios)
		lineageTag: 9bb3c5e7-5c3b-4be9-be6a-d8dab5bb82e2

	measure 'OPEX Real' = SUM(GastosOperativos[OPEXReal])
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 04 OPEX y EBITDA (SAP CO)
		lineageTag: 0e7c0308-4b49-49be-becc-0da3ae2c0861

	measure 'OPEX Presupuesto' = SUM(GastosOperativos[OPEXPresupuestado])
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 04 OPEX y EBITDA (SAP CO)
		lineageTag: b819ffdf-ae58-41fa-a3a1-2563203387d5

	measure 'Desvio OPEX' = [OPEX Real] - [OPEX Presupuesto]
		formatString: +$#,##0;-$#,##0;"-"
		displayFolder: 04 OPEX y EBITDA (SAP CO)
		lineageTag: 4efd28de-a79d-4742-bb09-c8ac5572bae0

	measure 'Desvio OPEX %' = DIVIDE([Desvio OPEX], [OPEX Presupuesto], 0)
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: 04 OPEX y EBITDA (SAP CO)
		lineageTag: fea1f7ca-afff-4298-83d0-c224c4ea3fcf

	measure 'Ratio OPEX s/Ingresos Real' = DIVIDE([OPEX Real], [Ingresos Reales], 0)
		formatString: 0.00%
		displayFolder: 04 OPEX y EBITDA (SAP CO)
		lineageTag: cff8a415-5b86-475a-b3b4-70537e838079

	measure 'Ratio OPEX s/Ingresos Presupuesto' = DIVIDE([OPEX Presupuesto], [Ingresos Presupuesto], 0)
		formatString: 0.00%
		displayFolder: 04 OPEX y EBITDA (SAP CO)
		lineageTag: c70f989e-cc75-4488-9dd7-f573f87d1ae6

	measure 'Desvio Ratio OPEX Puntos' = [Ratio OPEX s/Ingresos Real] - [Ratio OPEX s/Ingresos Presupuesto]
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: 04 OPEX y EBITDA (SAP CO)
		lineageTag: d3b3dbae-042e-418d-94fb-d9f19abf14a0

	measure 'Alerta Semaforo OPEX' =
			SWITCH(
				TRUE(),
				[Desvio OPEX %] > 0.05, "[CRITICO]",
				[Desvio OPEX %] > 0.00, "[ALERTA]",
				"[EN PLAN]"
			)
		formatString: @
		displayFolder: 04 OPEX y EBITDA (SAP CO)
		lineageTag: 3a868bd3-bedd-4e41-8b09-89442b6a8b8e

	measure 'Color Semaforo OPEX' =
			SWITCH(
				TRUE(),
				[Desvio OPEX %] > 0.05, "#EF4444",
				[Desvio OPEX %] > 0.00, "#F59E0B",
				"#10B981"
			)
		displayFolder: 04 OPEX y EBITDA (SAP CO)
		lineageTag: 30af8ce5-5575-4165-9db7-012a9718d9a0

	measure 'EBITDA Real' = [Margen Bruto Real] - [OPEX Real]
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 04 OPEX y EBITDA (SAP CO)
		lineageTag: 29647c23-8595-4c79-8879-e3d21f7d4380

	measure 'EBITDA Presupuesto' = [Margen Bruto Presupuesto] - [OPEX Presupuesto]
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 04 OPEX y EBITDA (SAP CO)
		lineageTag: d4a9cfa1-29bc-4ce2-98ea-23030ff90e4e

	measure 'Desvio EBITDA' = [EBITDA Real] - [EBITDA Presupuesto]
		formatString: +$#,##0;-$#,##0;"-"
		displayFolder: 04 OPEX y EBITDA (SAP CO)
		lineageTag: 1ec98121-9d7a-40b0-b548-f1cf6720bc11

	measure 'Desvio EBITDA %' = DIVIDE([Desvio EBITDA], ABS([EBITDA Presupuesto]), 0)
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: 04 OPEX y EBITDA (SAP CO)
		lineageTag: e58f248a-d147-4544-aa1d-7676202e6382

	measure 'Margen EBITDA % Real' = DIVIDE([EBITDA Real], [Ingresos Reales], 0)
		formatString: 0.00%
		displayFolder: 04 OPEX y EBITDA (SAP CO)
		lineageTag: bb97c03e-5b8b-40c3-9e5f-ec2733acd48a

	measure 'Margen EBITDA % Presupuesto' = DIVIDE([EBITDA Presupuesto], [Ingresos Presupuesto], 0)
		formatString: 0.00%
		displayFolder: 04 OPEX y EBITDA (SAP CO)
		lineageTag: 33136d1b-567e-4f80-96dc-c874e1dbca5e

	measure 'DSO Promedio' = AVERAGE(CapitalTrabajo[DSO_DiasCobro])
		formatString: 0.0 "días"
		displayFolder: 05 Capital de Trabajo y Liquidez
		lineageTag: 1418cb8f-0c7e-4831-ad97-b3e5a6c5cb60

	measure 'DIO Promedio' = AVERAGE(CapitalTrabajo[DIO_DiasInventario])
		formatString: 0.0 "días"
		displayFolder: 05 Capital de Trabajo y Liquidez
		lineageTag: 54fda788-6d68-481e-9545-ce1d3abd5177

	measure 'DPO Promedio' = AVERAGE(CapitalTrabajo[DPO_DiasPago])
		formatString: 0.0 "días"
		displayFolder: 05 Capital de Trabajo y Liquidez
		lineageTag: f337cc5c-8a21-4d4f-86ac-dbd02f0ccc6a

	measure 'Ciclo Conversion Efectivo (CCC)' = [DIO Promedio] + [DSO Promedio] - [DPO Promedio]
		formatString: 0.0 "días"
		displayFolder: 05 Capital de Trabajo y Liquidez
		lineageTag: a913e4f0-5438-4191-a4ce-acf5d8299537

	measure 'Cuentas por Cobrar Total' = SUM(CapitalTrabajo[CuentasPorCobrar])
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 05 Capital de Trabajo y Liquidez
		lineageTag: 16d7c729-c146-41fa-8cfe-fd5266db9601

	measure 'Inventario Total' = SUM(CapitalTrabajo[Inventario])
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 05 Capital de Trabajo y Liquidez
		lineageTag: f471108c-8787-42a7-84bb-36b3471623b0

	measure 'Cuentas por Pagar Total' = SUM(CapitalTrabajo[CuentasPorPagar])
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 05 Capital de Trabajo y Liquidez
		lineageTag: e352e8a7-a78c-4fda-96a4-ad0c3a6ae089

	measure 'NOF Total' = [Cuentas por Cobrar Total] + [Inventario Total] - [Cuentas por Pagar Total]
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 05 Capital de Trabajo y Liquidez
		lineageTag: 149f508c-c33c-4287-83a1-7eb6ac929e84

	measure 'Activo Operativo Liquido' = [Cuentas por Cobrar Total] + [Inventario Total]
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 05 Capital de Trabajo y Liquidez
		lineageTag: 43c4fb6a-c6ff-4bb4-9c8c-b49d729bfc03

	measure 'Ratio Cobertura Proveedores' = DIVIDE([Activo Operativo Liquido], [Cuentas por Pagar Total], 0)
		formatString: 0.00%
		displayFolder: 05 Capital de Trabajo y Liquidez
		lineageTag: 7344ca29-dfcb-4fcb-9308-2795c0029a80

	measure 'Efecto Mix de Cartera' = [Efecto Volumen (EV)] * 0.08
		formatString: +$#,##0;-$#,##0;"-"
		displayFolder: 02 Variance Analysis
		lineageTag: 0350b430-c1b4-4ab1-beec-2520e5931fa4

	measure 'Efecto Volumen Puro' = [Efecto Volumen (EV)] - [Efecto Mix de Cartera]
		formatString: +$#,##0;-$#,##0;"-"
		displayFolder: 02 Variance Analysis
		lineageTag: d03dfef0-a335-4d30-a2d2-a31d13342bad

	measure 'Impuesto a las Ganancias Estimado' = [EBITDA Real] * 0.35
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 06 Flujo de Fondos y Creacion de Valor
		lineageTag: e7241d19-99c7-4c1e-9e23-20f14c21dfec

	measure 'Variacion Capital de Trabajo Delta NOF' = [NOF Total] * 0.15
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 06 Flujo de Fondos y Creacion de Valor
		lineageTag: 411967a2-29de-4c70-8b97-3c154f601b2c

	measure 'CAPEX Operativo Bodega' = [Ingresos Reales] * 0.025
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 06 Flujo de Fondos y Creacion de Valor
		lineageTag: 8de1139c-161d-4392-975b-5b99b193ebcc

	measure 'Free Cash Flow to Firm FCFF' = [EBITDA Real] - [Impuesto a las Ganancias Estimado] - [Variacion Capital de Trabajo Delta NOF] - [CAPEX Operativo Bodega]
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 06 Flujo de Fondos y Creacion de Valor
		lineageTag: 400d97fe-47dc-44e8-bfcd-a75c7b5d06e5

	measure 'Rotacion de Activos Operativos' = DIVIDE([Ingresos Reales], [Activo Operativo Liquido], 0)
		formatString: 0.00
		displayFolder: 06 Flujo de Fondos y Creacion de Valor
		lineageTag: b363dc72-5841-4d4f-bd75-2f44e06c356b

	measure 'Margen Neto Operativo' = DIVIDE([EBITDA Real] - [Impuesto a las Ganancias Estimado], [Ingresos Reales], 0)
		formatString: 0.00%
		displayFolder: 06 Flujo de Fondos y Creacion de Valor
		lineageTag: f8d92caa-5a85-4252-9a97-2739839c8af0

	measure 'Retorno DuPont Operativo' = [Margen Neto Operativo] * [Rotacion de Activos Operativos]
		formatString: 0.00%
		displayFolder: 06 Flujo de Fondos y Creacion de Valor
		lineageTag: acbe43ad-fb95-409c-a7a9-3a842138d4e8

	measure 'ROIC Estimado' = DIVIDE([EBITDA Real] * (1 - 0.35), [NOF Total] + [CAPEX Operativo Bodega] * 4, 0)
		formatString: 0.00%
		displayFolder: 06 Flujo de Fondos y Creacion de Valor
		lineageTag: 27c0d2a4-9c15-4082-bb36-f840f80597b8

	measure 'EVA Estimado' = ([NOF Total] + [CAPEX Operativo Bodega] * 4) * ([ROIC Estimado] - 0.12)
		formatString: +$#,##0;-$#,##0;"-"
		displayFolder: 06 Flujo de Fondos y Creacion de Valor
		lineageTag: 37188d53-3491-4dce-baf8-7a211c6bebab

	measure 'Semaforo KPI' =
			VAR _desvio = [Desvio Ingresos %]
			RETURN
			    SWITCH(
			        TRUE(),
			        _desvio >= 0,               "CUMPLE",
			        _desvio >= -0.05,           "ALERTA",
			        "CRITICO"
			    )
		formatString: @
		displayFolder: 07 Diagnostico Causal
		lineageTag: 9d392a34-50f3-4577-bb59-718dad1e54f0

	measure 'Color Semaforo KPI' =
			SWITCH(
			    [Semaforo KPI],
			    "CUMPLE",  "#065F46",
			    "ALERTA",  "#92400E",
			    "CRITICO", "#7F1D1D",
			    "#1E293B"
			)
		formatString: @
		displayFolder: 07 Diagnostico Causal
		lineageTag: c5f660e5-027a-402d-b5d0-a2791e9dce1d

	measure 'Top Causa Desvio' =
			VAR _dominante = [Efecto Dominante Margen]
			VAR _tbl_dim =
				IF(
					HASONEVALUE(Productos[Linea]),
					ADDCOLUMNS(
						VALUES(Productos[Descripcion]),
						"@aporte",
						SWITCH(
							_dominante,
							"Efecto Volumen (EV)", [Efecto Volumen (EV)],
							"Efecto Precio (EP)", [Efecto Precio (EP)],
							[Efecto Costo (EC)]
						)
					),
					ADDCOLUMNS(
						VALUES(Productos[Linea]),
						"@aporte",
						SWITCH(
							_dominante,
							"Efecto Volumen (EV)", [Efecto Volumen (EV)],
							"Efecto Precio (EP)", [Efecto Precio (EP)],
							[Efecto Costo (EC)]
						)
					)
				)
			VAR _top = TOPN(1, _tbl_dim, ABS([@aporte]), DESC)
			RETURN
				IF(
					HASONEVALUE(Productos[Linea]),
					CONCATENATEX(_top, Productos[Descripcion], ", "),
					CONCATENATEX(_top, Productos[Linea], ", ")
				)
		formatString: @
		displayFolder: 07 Diagnostico Causal
		lineageTag: 18eb21fb-a5d9-4b42-aaf9-b7efa3532085

	measure 'Magnitud Desvio Top Causa' =
			VAR _dominante = [Efecto Dominante Margen]
			VAR _tbl_dim =
				IF(
					HASONEVALUE(Productos[Linea]),
					ADDCOLUMNS(
						VALUES(Productos[Descripcion]),
						"@aporte",
						SWITCH(
							_dominante,
							"Efecto Volumen (EV)", [Efecto Volumen (EV)],
							"Efecto Precio (EP)", [Efecto Precio (EP)],
							[Efecto Costo (EC)]
						)
					),
					ADDCOLUMNS(
						VALUES(Productos[Linea]),
						"@aporte",
						SWITCH(
							_dominante,
							"Efecto Volumen (EV)", [Efecto Volumen (EV)],
							"Efecto Precio (EP)", [Efecto Precio (EP)],
							[Efecto Costo (EC)]
						)
					)
				)
			VAR _top = TOPN(1, _tbl_dim, ABS([@aporte]), DESC)
			RETURN
				MAXX(_top, [@aporte])
		formatString: +$#,##0;-$#,##0;"-"
		displayFolder: 07 Diagnostico Causal
		lineageTag: 193cfdc4-d5c5-4d12-8813-6f8e210eaea1

	measure 'Diagnostico Causal' =
			VAR _mb_real = [Margen Bruto Real]
			VAR _mb_ppto = [Margen Bruto Presupuesto]
			VAR _desvio_mb = _mb_real - _mb_ppto
			VAR _desvio_pct = DIVIDE(_desvio_mb, _mb_ppto, 0)
			VAR _dominante = [Efecto Dominante Margen]
			VAR _top_item = [Top Causa Desvio]
			VAR _monto_m = FORMAT(ABS(_desvio_mb) / 1000000, "$#,##0.0 M")
			VAR _res =
				IF(
					_desvio_mb >= 0,
					"Superavit de Margen: +" & _monto_m & " (" & FORMAT(_desvio_pct, "+0.0%") & "). Causa: " & _dominante & " en " & _top_item & ".",
					"Desvio de Margen: -" & _monto_m & " (" & FORMAT(_desvio_pct, "0.0%") & "). Detractor: " & _dominante & " en " & _top_item & "."
				)
			RETURN LEFT(_res, 125)
		formatString: @
		displayFolder: 07 Diagnostico Causal
		lineageTag: 1917c896-c37e-4f13-ac36-7e3402c2e6b6

	measure 'Rank Desvio por Dimension' =
			VAR _tbl = ADDCOLUMNS(VALUES(PlanCuentas[NombreCuenta]), "@dev", ABS(CALCULATE([Desvio Ingresos %])))
			RETURN RANKX(_tbl, [@dev], , DESC, Skip)
		formatString: 0
		displayFolder: 07 Diagnostico Causal
		lineageTag: 0e14847f-4823-4c1e-9b30-6f32dd50a0f0

	measure 'KPI Fuera de Objetivo' = IF([Desvio Ingresos %] < -0.05, 1, 0)
		formatString: 0
		displayFolder: 07 Diagnostico Causal
		lineageTag: bfe77d28-b8e4-47b2-bddf-6c5cca41e688

	measure 'Varianza Absoluta KPI' = [Ingresos Reales] - [Ingresos Presupuesto]
		displayFolder: 07 Diagnostico Causal
		lineageTag: eab026ad-5b0e-403a-a60c-a7f07efc3130

	measure 'Periodo Seleccionado' =
			VAR _anio = SELECTEDVALUE(Calendario[Anio], "Todos")
			VAR _mes  = SELECTEDVALUE(Calendario[MesNombre], "")
			RETURN
			    IF(_mes <> "", _anio & " — " & _mes, _anio & " (todos los meses)")
		formatString: @
		displayFolder: 08 Storytelling y Contexto
		lineageTag: 784f0c6f-ad6f-4d5e-97d5-b962336fc7f3

	measure 'Titulo Dinamico Principal' = "Evolucion " & [Ingresos Reales] & " — " & [Periodo Seleccionado]
		formatString: @
		displayFolder: 08 Storytelling y Contexto
		lineageTag: 316c08b8-3ee8-40e0-a2b7-026803d324fb

	measure 'Real Anio Anterior' = CALCULATE([Ingresos Reales], SAMEPERIODLASTYEAR(Calendario[Fecha]))
		displayFolder: 08 Storytelling y Contexto
		lineageTag: afce7bf0-aa7e-4204-be06-63cb8a5b4de5

	measure 'Variacion YoY' = DIVIDE([Ingresos Reales] - [Real Anio Anterior], ABS([Real Anio Anterior]), BLANK())
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 08 Storytelling y Contexto
		lineageTag: 420a3d8e-1cc6-4a81-a872-3cfed4cb42c5

	measure 'Variacion YoY Texto' =
			VAR _yoy = [Variacion YoY]
			RETURN
			    IF(
			        ISBLANK(_yoy),
			        "Sin periodo anterior comparable",
			        IF(_yoy >= 0,
			            "+" & FORMAT(_yoy, "0.0%") & " vs. año anterior",
			            FORMAT(_yoy, "0.0%") & " vs. año anterior"
			        )
			    )
		formatString: @
		displayFolder: 08 Storytelling y Contexto
		lineageTag: eb8fac29-210c-41a8-af06-d36dc020dd8e

	measure 'Resumen Ejecutivo' =
			VAR _estado   = [Semaforo KPI]
			VAR _dev      = FORMAT(ABS([Desvio Ingresos %]), "0.0%")
			VAR _yoy      = [Variacion YoY Texto]
			VAR _causa    = [Top Causa Desvio]
			VAR _periodo  = [Periodo Seleccionado]
			RETURN
			    SWITCH(
			        _estado,
			        "CUMPLE",
			            "SITUACION: En objetivo para " & _periodo & ". " &
			            "El cumplimiento es positivo con " & _yoy & ". " &
			            "Impulsor principal: " & _causa & ".",
			        "ALERTA",
			            "ATENCION: Desvio moderado (" & _dev & " bajo plan) en " & _periodo & ". " &
			            _yoy & ". " &
			            "Revisar: " & _causa & ".",
			        "CRITICO",
			            "ACCION URGENTE: Desvio critico (" & _dev & " bajo plan) en " & _periodo & ". " &
			            _yoy & ". " &
			            "Dimension mas comprometida: " & _causa & ". Se requiere plan de recuperacion."
			    )
		formatString: @
		displayFolder: 08 Storytelling y Contexto
		lineageTag: d2fc45f3-58ff-4e6b-bcd6-160b1a759956

	measure 'Tendencia YoY Icono' = IF([Variacion YoY] >= 0, "▲", "▼")
		formatString: @
		displayFolder: 08 Storytelling y Contexto
		lineageTag: 1cc35831-e384-46b5-b322-042e2cc20ba5

	measure 'Nivel Riesgo CCC' =
			SWITCH(
				TRUE(),
				ISBLANK([Ciclo Conversion Efectivo (CCC)]), BLANK(),
				[Ciclo Conversion Efectivo (CCC)] <= 65, "[EN PLAN]",
				[Ciclo Conversion Efectivo (CCC)] <= 85, "[ALERTA]",
				"[CRITICO]"
			)
		formatString: @
		displayFolder: 09 Diagnostico Prescriptivo
		lineageTag: 44197ede-2bc6-46e2-85a8-01bd776384de

	measure 'Color Riesgo CCC' =
			SWITCH(
				[Nivel Riesgo CCC],
				"OPTIMO", "#10B981",
				"[EN PLAN]", "#10B981",
				"ALERTA", "#F59E0B",
				"[ALERTA]", "#F59E0B",
				"CRITICO", "#EF4444",
				"[CRITICO]", "#EF4444",
				"#94A3B8"
			)
		formatString: @
		displayFolder: 09 Diagnostico Prescriptivo
		lineageTag: e50d58d5-6f4d-4dc9-9bc6-80cfa3147e2e

	measure 'Prescripcion Operativa CCC' =
			VAR _ccc = [Ciclo Conversion Efectivo (CCC)]
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(_ccc), "Sin datos",
					_ccc <= 65, "Liquidez y ciclo equilibrado",
					_ccc <= 85, "Monitorear stock e inventario",
					"Acelerar cobranzas y diferir pagos"
				)
		formatString: @
		displayFolder: 09 Diagnostico Prescriptivo
		lineageTag: 83ab073f-d05a-4353-ac83-4d951c4b5074

	measure 'Rotacion Activos Operativos' = DIVIDE([Ingresos Reales], [NOF Total], BLANK())
		formatString: 0.00"x"
		displayFolder: 09 Diagnostico Prescriptivo
		lineageTag: 5df486e1-c0e2-4e5c-b082-c1fce7cddbf4

	measure 'Nivel Riesgo Rotacion Activos' =
			VAR _rot = [Rotacion Activos Operativos]
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(_rot), BLANK(),
					_rot >= 1.2, "[ALTA]",
					_rot >= 0.9, "[MEDIA]",
					"[BAJA]"
				)
		formatString: @
		displayFolder: 09 Diagnostico Prescriptivo
		lineageTag: a662c757-9148-44b0-85d7-7047d609b6bc

	measure 'Prescripcion Rotacion Activos' =
			VAR _rot = [Rotacion Activos Operativos]
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(_rot), "Sin datos",
					_rot >= 1.2, "Alta productividad de capital",
					_rot >= 0.9, "Rotacion de activos aceptable",
					"Desestibar lotes estancados"
				)
		formatString: @
		displayFolder: 09 Diagnostico Prescriptivo
		lineageTag: e6787c07-dbeb-40a6-a29d-783a4bcc8b3f

	measure 'Diagnostico Prescriptivo PnL' =
			VAR _devTotal = [Desvio Margen Bruto Total]
			VAR _ev = [Efecto Volumen (EV)]
			VAR _ep = [Efecto Precio (EP)]
			VAR _ec = [Efecto Costo (EC)]
			VAR _devM = FORMAT(ABS(_devTotal) / 1000000, "$#,##0.0 M")
			VAR _evM = FORMAT(_ev / 1000000, "+$#,##0.0 M;-$#,##0.0 M;$0.0 M")
			VAR _epM = FORMAT(_ep / 1000000, "+$#,##0.0 M;-$#,##0.0 M;$0.0 M")
			VAR _ecM = FORMAT(_ec / 1000000, "+$#,##0.0 M;-$#,##0.0 M;$0.0 M")
			VAR _res =
				IF(
					_devTotal >= 0,
					"Superavit Margen: +" & _devM & " por mix favorable. Prescripcion: Consolidar asignacion a lineas de alta gama.",
					IF(
						_ep < _ev && _ep < _ec,
						"Desvio en Precio (EP: " & _epM & "). Prescripcion: Limitar bonificaciones comerciales y topear descuentos al 8%.",
						IF(
							_ev < _ep && _ev < _ec,
							"Desvio en Volumen (EV: " & _evM & "). Prescripcion: Reforzar incentivos de ventas y acelerar canal Horeca.",
							"Desvio en Costos (EC: " & _ecM & "). Prescripcion: Auditar adquisicion de insumos secos y turnos en planta."
						)
					)
				)
			RETURN LEFT(_res, 125)
		formatString: @
		displayFolder: 09 Diagnostico Prescriptivo
		lineageTag: 275be823-7a40-45b7-a4f6-1e577cd29d01

	measure 'Color Diagnostico Prescriptivo PnL' = IF([Desvio Margen Bruto Total] >= 0, "#065F46", "#7F1D1D")
		formatString: @
		displayFolder: 09 Diagnostico Prescriptivo
		lineageTag: be121f0f-793b-4156-b65f-5709a5b7b9d4

	measure 'Ciclo Conversion Efectivo' = [Ciclo Conversion Efectivo (CCC)]
		formatString: 0.0
		displayFolder: 05 Capital de Trabajo y Ciclo de Efectivo
		lineageTag: a1b2c3d4-9999-0001-0001-000000000001

	measure 'DSO Dias' = [DSO Promedio]
		formatString: 0.0
		displayFolder: 05 Capital de Trabajo y Ciclo de Efectivo
		lineageTag: a1b2c3d4-9999-0001-0001-000000000002

	measure 'DIO Dias' = [DIO Promedio]
		formatString: 0.0
		displayFolder: 05 Capital de Trabajo y Ciclo de Efectivo
		lineageTag: a1b2c3d4-9999-0001-0001-000000000003

	measure 'DPO Dias' = [DPO Promedio]
		formatString: 0.0
		displayFolder: 05 Capital de Trabajo y Ciclo de Efectivo
		lineageTag: a1b2c3d4-9999-0001-0001-000000000004

	measure 'NOF Requerida' = [NOF Total]
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 05 Capital de Trabajo y Ciclo de Efectivo
		lineageTag: a1b2c3d4-9999-0001-0001-000000000005

	measure 'Efecto Volumen EV' = [Efecto Volumen (EV)]
		formatString: +$#,##0;-$#,##0;"-"
		displayFolder: 04 Descomposicion de Desvios (Variance Analysis)
		lineageTag: a1b2c3d4-9999-0001-0001-000000000006

	measure 'Efecto Precio EP' = [Efecto Precio (EP)]
		formatString: +$#,##0;-$#,##0;"-"
		displayFolder: 04 Descomposicion de Desvios (Variance Analysis)
		lineageTag: a1b2c3d4-9999-0001-0001-000000000007

	measure 'Efecto Costo EC' = [Efecto Costo (EC)]
		formatString: +$#,##0;-$#,##0;"-"
		displayFolder: 04 Descomposicion de Desvios (Variance Analysis)
		lineageTag: a1b2c3d4-9999-0001-0001-000000000008

	measure 'Efecto Dominante Margen' =
			VAR _ev = ABS([Efecto Volumen (EV)])
			VAR _ep = ABS([Efecto Precio (EP)])
			VAR _ec = ABS([Efecto Costo (EC)])
			RETURN
				SWITCH(
					TRUE(),
					_ev >= _ep && _ev >= _ec, "Efecto Volumen (EV)",
					_ep >= _ev && _ep >= _ec, "Efecto Precio (EP)",
					"Efecto Costo (EC)"
				)
		formatString: @
		displayFolder: 07 Diagnostico Causal
		lineageTag: d71a8f9c-3e2b-4a5c-8901-2b4f6e8a10d2

	column Medidas
		dataType: string
		isHidden
