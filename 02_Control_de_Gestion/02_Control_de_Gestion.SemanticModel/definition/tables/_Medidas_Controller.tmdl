	measure 'Costo Presupuesto' = SUM(PresupuestoVentas[CostoPresupuestado])
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 02 Costos y Margen Bruto
		lineageTag: 8eb83c94-d1ed-4d78-a94f-900b4537082f

	measure 'Desvio Costo Total' = [Costo Real] - [Costo Presupuesto]
		formatString: +$#,##0;-$#,##0;"-"
		displayFolder: 02 Costos y Margen Bruto
		lineageTag: 8ea79ef1-0034-4105-9a78-5e25d3af008f

	measure 'Desvio Costo %' = DIVIDE([Desvio Costo Total], [Costo Presupuesto], 0)
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: 02 Costos y Margen Bruto
		lineageTag: 31f85811-b359-4d9c-b2e0-f39ee494bc0e

	measure 'Costo Unitario Real' = DIVIDE([Costo Real], [Volumen Real], 0)
		formatString: $#,##0.00;($#,##0.00);"-"
		displayFolder: 02 Costos y Margen Bruto
		lineageTag: 0888ed31-da63-4d57-9a6e-e0375e310fab

	measure 'Costo Unitario Presupuesto' = DIVIDE([Costo Presupuesto], [Volumen Presupuesto], 0)
		formatString: $#,##0.00;($#,##0.00);"-"
