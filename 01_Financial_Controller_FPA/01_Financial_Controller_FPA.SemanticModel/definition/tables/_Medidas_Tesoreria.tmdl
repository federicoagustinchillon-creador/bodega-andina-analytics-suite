table _Medidas_Tesoreria
	lineageTag: 8ac9d18a-f88c-4cf9-9e21-d366856b6478

	measure 'Spot ARS/USD Actual' =
			VAR _UltimaFecha = CALCULATE(MAX(fact_mercado_rofex_futuros[DateKey]))
			RETURN
			    CALCULATE(MAX(fact_mercado_rofex_futuros[TipoCambioSpotA3500]), fact_mercado_rofex_futuros[DateKey] = _UltimaFecha)
		formatString: $#,##0.00
		displayFolder: 01 Tesoreria y Cobertura Cambiaria
		lineageTag: a88bbfd0-cefb-49fc-8636-55d3f1bb062f

	measure 'TNA Implicita Rofex 3M' =
			VAR _UltimaFecha = CALCULATE(MAX(fact_mercado_rofex_futuros[DateKey]))
			VAR _Spot = CALCULATE(MAX(fact_mercado_rofex_futuros[TipoCambioSpotA3500]), fact_mercado_rofex_futuros[DateKey] = _UltimaFecha)
			VAR _Futuro = CALCULATE(MAX(fact_mercado_rofex_futuros[FuturoRofex3M]), fact_mercado_rofex_futuros[DateKey] = _UltimaFecha)
			VAR _Dias = CALCULATE(MAX(fact_mercado_rofex_futuros[DiasVencimiento3M]), fact_mercado_rofex_futuros[DateKey] = _UltimaFecha)
			RETURN
			    DIVIDE(_Futuro - _Spot, _Spot, 0) * DIVIDE(365, _Dias, 0)
		formatString: 0.00%
		displayFolder: 01 Tesoreria y Cobertura Cambiaria
		lineageTag: 2c4aba29-0440-40f0-9a77-2567dac59eac

	measure 'TNA Benchmark LECAP' =
			VAR _UltimaFecha = CALCULATE(MAX(fact_mercado_rofex_futuros[DateKey]))
			RETURN
			    CALCULATE(MAX(fact_mercado_rofex_futuros[TasaLecapReferenciaTNA]), fact_mercado_rofex_futuros[DateKey] = _UltimaFecha)
		formatString: 0.00%
		displayFolder: 01 Tesoreria y Cobertura Cambiaria
		lineageTag: 29062f6b-e38a-4b40-9075-97421546360a

	measure 'Spread Arbitraje bps' = ([TNA Implicita Rofex 3M] - [TNA Benchmark LECAP]) * 10000
		formatString: +#,##0;-#,##0;0
		displayFolder: 01 Tesoreria y Cobertura Cambiaria
		lineageTag: 601adcbd-98f3-4652-a92a-46ef0c7e3cac

	measure 'Recomendacion Cobertura' =
			SWITCH(
			    TRUE(),
			    [Spread Arbitraje bps] > 150, "Vender Futuro Rofex (tasa implicita cara)",
			    [Spread Arbitraje bps] < -150, "Financiar en Pesos (cobertura cara)",
			    "Calce / Indiferencia"
			)
		formatString: @
		displayFolder: 01 Tesoreria y Cobertura Cambiaria
		lineageTag: d3e3c5d6-785a-4fdf-8114-2180d302f4d5

	measure 'Color Recomendacion Cobertura' =
			SWITCH(
			    [Recomendacion Cobertura],
			    "Vender Futuro Rofex (tasa implicita cara)", "#10B981",
			    "Financiar en Pesos (cobertura cara)", "#EF4444",
			    "#F59E0B"
			)
		formatString: @
		displayFolder: 01 Tesoreria y Cobertura Cambiaria
		lineageTag: 4b73067d-2ebe-427d-94b9-a618d3d3c7f8

	measure 'Fecha Referencia Simulada' = DATE(2025, 11, 15)
		formatString: dd/mm/yyyy
		displayFolder: 02 Cobranzas de Exportacion USD
		lineageTag: 7a4e9c31-5b8d-4f6a-9e2c-1d7b8a3f6e02

	measure 'Cobranzas USD Pendientes' = CALCULATE(SUM(fact_cobranzas_exportacion_usd[ImporteFOB_USD]), fact_cobranzas_exportacion_usd[FechaCobroEstimada] > [Fecha Referencia Simulada], REMOVEFILTERS(dim_calendario))
		formatString: $#,##0" u$s"
		displayFolder: 02 Cobranzas de Exportacion USD
		lineageTag: 21554589-ad2f-48e0-95bb-80c2b128032b

	measure 'Cobranzas USD Cobradas' = CALCULATE(SUM(fact_cobranzas_exportacion_usd[ImporteFOB_USD]), fact_cobranzas_exportacion_usd[FechaCobroEstimada] <= [Fecha Referencia Simulada], REMOVEFILTERS(dim_calendario))
		formatString: $#,##0" u$s"
		displayFolder: 02 Cobranzas de Exportacion USD
		lineageTag: 64449db2-9392-41d0-87b6-a8b8de47ace1

	measure 'Cantidad Cobranzas Pendientes' = CALCULATE(COUNTROWS(fact_cobranzas_exportacion_usd), fact_cobranzas_exportacion_usd[FechaCobroEstimada] > [Fecha Referencia Simulada], REMOVEFILTERS(dim_calendario))
		formatString: #,##0
		displayFolder: 02 Cobranzas de Exportacion USD
		lineageTag: ccb3c74a-2817-4632-8538-c63248646e76

	measure 'Exposicion Cambiaria Neta USD' = [Cobranzas USD Pendientes]
		formatString: $#,##0" u$s"
		displayFolder: 01 Tesoreria y Cobertura Cambiaria
		lineageTag: 498b55f0-4ea5-49de-bf4a-18b11a145d2e

	measure 'Exposicion Cambiaria Neta ARS' = [Exposicion Cambiaria Neta USD] * [Spot ARS/USD Actual]
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 01 Tesoreria y Cobertura Cambiaria
		lineageTag: 887b237f-f168-4ed4-b143-4f9e3e3850a5

	measure 'Plazo Promedio Cobro Dias' = AVERAGE(fact_cobranzas_exportacion_usd[PlazoDiasCobro])
		formatString: #,##0.0
		displayFolder: 02 Cobranzas de Exportacion USD
		lineageTag: 87a5c8ce-aecd-48e7-97ac-1f10f0bd0bf3

	measure 'Spot ARS/USD Serie' = AVERAGE(fact_mercado_rofex_futuros[TipoCambioSpotA3500])
		formatString: $#,##0.00
		displayFolder: 01 Tesoreria y Cobertura Cambiaria
		lineageTag: 6f3a1b8e-7c2d-4a1e-9b5f-3d8c2e1a4f7b

	measure 'Futuro Rofex 3M Serie' = AVERAGE(fact_mercado_rofex_futuros[FuturoRofex3M])
		formatString: $#,##0.00
		displayFolder: 01 Tesoreria y Cobertura Cambiaria
		lineageTag: 9d2e4c7a-1f6b-48d3-a2e9-7b5c3f1d8a6e

	column Medidas
		dataType: string
		isHidden
		lineageTag: 4c578464-8587-49f6-90a5-2e719d8864c7
		summarizeBy: none
		isNameInferred
		sourceColumn: [Medidas]

		annotation SummarizationSetBy = Automatic

	partition _Medidas_Tesoreria = calculated
		mode: import
		source = Row("Medidas", "Tabla Centralizada de Medidas Tesoreria")

