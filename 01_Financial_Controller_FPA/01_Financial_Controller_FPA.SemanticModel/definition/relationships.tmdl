relationship rel_presupuesto_productos
	fromColumn: fact_presupuesto_ventas.ProductoID
	toColumn: dim_productos.ProductoID

relationship rel_presupuesto_centroscosto
	fromColumn: fact_presupuesto_ventas.CentroCostoID
	toColumn: dim_centros_costo.CentroCostoID

