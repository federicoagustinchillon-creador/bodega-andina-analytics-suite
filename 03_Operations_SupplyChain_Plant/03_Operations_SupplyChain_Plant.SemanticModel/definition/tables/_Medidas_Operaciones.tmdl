table _Medidas_Operaciones
	lineageTag: d3b25446-cdc1-4fb0-9d4a-01b7d86b3916


	measure 'Total Kilos Uva' = SUM(fact_operaciones_planta[KilosEntrada])
		formatString: #,##0
		displayFolder: 01 Eficiencia y Recepcion Vendimia
		lineageTag: f22e60d5-54db-4565-829c-8f446dcefed1

	measure 'Total Litros Mosto' = SUM(fact_operaciones_planta[LitrosMostoObtenido])
		formatString: #,##0
		displayFolder: 01 Eficiencia y Recepcion Vendimia
		lineageTag: 6e09dbd9-f584-49dc-8705-38e97217bfd8

	measure 'Rendimiento Medio Extraccion %' = DIVIDE([Total Litros Mosto], [Total Kilos Uva], 0)
		formatString: 0.00%
		displayFolder: 01 Eficiencia y Recepcion Vendimia
		lineageTag: 5969a545-6c70-4d3e-a2e0-34e0f1c87859

	measure 'Grados Brix Ponderado' = DIVIDE(SUMX(fact_operaciones_planta, fact_operaciones_planta[GradosBrix] * fact_operaciones_planta[KilosEntrada]), [Total Kilos Uva], 0)
		formatString: 0.0 "°Bx"
		displayFolder: 01 Eficiencia y Recepcion Vendimia
		lineageTag: 2d060b55-4845-4579-b0f2-30fd01fde3b5

	measure 'Total Remitos' = DISTINCTCOUNT(fact_operaciones_planta[RemitoID])
		formatString: #,##0
		displayFolder: 01 Eficiencia y Recepcion Vendimia
		lineageTag: e5d9f55b-48f1-49d8-8159-1096c13b046b

	measure 'Total Botellas Equivalentes' = DIVIDE([Total Litros Mosto], 0.75, 0)
		formatString: #,##0
		displayFolder: 01 Eficiencia y Recepcion Vendimia
		lineageTag: 8f541a3a-172d-4031-8e17-a604747583d5


	measure 'Costo Elaboracion Total' = CALCULATE(SUM(fact_opex_mensual[OPEXReal]), fact_opex_mensual[CentroCostoID] = "CC-101")
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: 6df7faef-a1b7-48b4-9f96-3f69d4cadeb8

	measure 'Costo Fraccionamiento Total' = CALCULATE(SUM(fact_opex_mensual[OPEXReal]), fact_opex_mensual[CentroCostoID] = "CC-102")
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: 71595ec1-32d5-457f-b5c6-dd6fad121c39

	measure 'Costo Mantenimiento Total' = CALCULATE(SUM(fact_opex_mensual[OPEXReal]), fact_opex_mensual[CentroCostoID] = "CC-103")
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: 4dfc4389-fac5-45fb-9b7e-c42b62deb396

	measure 'Costo Total Fabril' = CALCULATE(SUM(fact_opex_mensual[OPEXReal]), fact_opex_mensual[CentroCostoID] IN {"CC-101", "CC-102", "CC-103"})
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: ed2779e1-1baa-4ef8-81a6-9ec923e5612f

	measure 'Costo Presupuesto Fabril' = CALCULATE(SUM(fact_opex_mensual[OPEXPresupuestado]), fact_opex_mensual[CentroCostoID] IN {"CC-101", "CC-102", "CC-103"})
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: 1e87e2fa-e352-448a-88e7-f83a6a0a0384

	measure 'Desvio Fabril Total' = [Costo Total Fabril] - [Costo Presupuesto Fabril]
		formatString: +$#,##0;-$#,##0;"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: af19f177-bc07-4f96-8822-1fee820330fb

	measure 'Desvio Fabril %' = DIVIDE([Desvio Fabril Total], [Costo Presupuesto Fabril], 0)
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: befd260b-c8bf-42ee-a567-df0c4244706a

	measure 'Color Semaforo Fabril' =
			SWITCH(
				TRUE(),
				[Desvio Fabril %] > 0.05, "#EF4444",
				[Desvio Fabril %] > 0.00, "#F59E0B",
				"#10B981"
			)
		formatString: "@"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: 8a1e4f27-3c9b-4d68-a5f1-0e7c2b9a4d6e

	measure 'Costo Unitario Elaboracion' = DIVIDE([Costo Elaboracion Total], [Total Litros Mosto], 0)
		formatString: $#,##0.00;($#,##0.00);"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: 1b8f4fdc-9c97-4045-964f-eb036d98fe98

	measure 'Costo Unitario Envasado' = DIVIDE([Costo Fraccionamiento Total], [Total Botellas Equivalentes], 0)
		formatString: $#,##0.00;($#,##0.00);"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: 4de2c217-1b7b-470d-a7bf-6b57df974d65

	measure 'Costo Unitario Real por Botella' = DIVIDE([Costo Total Fabril], [Total Botellas Equivalentes], 0)
		formatString: $#,##0.00;($#,##0.00);"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: a43c9057-99c3-4f12-8035-7836fd873e2f

	measure 'Costo Estandar Unitario' = DIVIDE([Costo Presupuesto Fabril], [Total Botellas Equivalentes], 0)
		formatString: $#,##0.00;($#,##0.00);"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: 325aef5b-ba1c-4178-a513-9c4bd2e6cf15

	measure 'Desvio Fabril Unitario' = [Costo Unitario Real por Botella] - [Costo Estandar Unitario]
		formatString: +$#,##0.00;-$#,##0.00;"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: 0942d548-109b-4235-a14b-0e34ddcf6ff8

	measure 'Tasa Eficiencia Planta' = DIVIDE([Costo Presupuesto Fabril], [Costo Total Fabril], 0)
		formatString: 0.00%
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: 51e6a8d1-ac40-4757-a513-08aa9bafa60f

	measure 'Costo Fabril Real Centro' = SUM(fact_opex_mensual[OPEXReal])
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: 3bc498ee-6701-4e56-9fdf-f55bbc00b8be

	measure 'Costo Fabril Plan Centro' = SUM(fact_opex_mensual[OPEXPresupuestado])
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: 5ca4bd41-d598-4b90-95d3-4fb6439bee94

	measure 'Desvio Fabril Centro' = [Costo Fabril Real Centro] - [Costo Fabril Plan Centro]
		formatString: +$#,##0;-$#,##0;"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: d1bb878b-0647-49c1-ba99-95e59e8da277

	measure 'Desvio Fabril Centro %' = DIVIDE([Desvio Fabril Centro], [Costo Fabril Plan Centro], 0)
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: 92cd3880-cb4c-4389-94f8-e5bdc8a59ea4

	measure 'Costo Cuenta Real' = SUM(fact_opex_mensual[OPEXReal])
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: 9d2c09ba-3919-456c-9316-4c5403c54418

	measure 'Costo Cuenta Plan' = SUM(fact_opex_mensual[OPEXPresupuestado])
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: 6a60f3a1-0f90-40b6-b8a2-35395757b4c3

	measure 'Desvio Cuenta' = [Costo Cuenta Real] - [Costo Cuenta Plan]
		formatString: +$#,##0;-$#,##0;"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: d76dc348-dfaf-4e3e-b476-23e77ff82a72


	measure 'Valor Inventario Guarda' = SUM(fact_inventario_guarda[ValorInventario])
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 03 Inventario Guarda y Mermas
		lineageTag: 96ebb839-a2c8-470b-ac69-23b64b347ad2

	measure 'Litros en Crianza' = SUM(fact_inventario_guarda[Litros])
		formatString: #,##0 "L"
		displayFolder: 03 Inventario Guarda y Mermas
		lineageTag: e4b2c1a0-7f39-4d8b-9a1c-52c6f1a3b4c5

	measure 'DIO Promedio Dias' = AVERAGE(fact_inventario_guarda[DIODias])
		formatString: 0.0 "días"
		displayFolder: 03 Inventario Guarda y Mermas
		lineageTag: eca5752f-2cef-4dee-9337-f8946fbb2006

	measure 'Tasa Merma Crianza %' = AVERAGE(fact_inventario_guarda[MermaPct])
		formatString: 0.00%
		displayFolder: 03 Inventario Guarda y Mermas
		lineageTag: 0f03755a-8562-41b5-b241-b59e1c735e34

	measure 'Merma Madera %' = [Tasa Merma Crianza %]
		formatString: 0.00%
		displayFolder: 03 Inventario Guarda y Mermas
		lineageTag: 0f03755a-8562-41b5-b241-b59e1c735e33

	measure 'Eficiencia de Planta %' = [Tasa Eficiencia Planta]
		formatString: 0.00%
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: 51e6a8d1-ac40-4757-a513-08aa9bafa60e

	measure 'Stock Insumos Secos Meses' = DIVIDE([DIO Promedio Dias], 30, 0)
		formatString: 0.0 "meses"
		displayFolder: 03 Inventario Guarda y Mermas
		lineageTag: 1aad7b80-9cb7-44ce-bf09-3f9e21a36754

	measure 'Stock Piletas Acero' = CALCULATE(SUM(fact_inventario_guarda[ValorInventario]), fact_inventario_guarda[TipoVasija] = "Piletas de Acero Inoxidable")
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 03 Inventario Guarda y Mermas
		lineageTag: 8be809f9-f275-4802-93f0-72673778653a

	measure 'Stock Barricas Crianza' = CALCULATE(SUM(fact_inventario_guarda[ValorInventario]), fact_inventario_guarda[TipoVasija] IN {"Barricas de Roble Frances", "Barricas de Roble Americano"})
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 03 Inventario Guarda y Mermas
		lineageTag: 28970b22-e55c-4f77-8622-796120fbe657

	measure 'Stock Botellas Estiba' = CALCULATE(SUM(fact_inventario_guarda[ValorInventario]), fact_inventario_guarda[TipoVasija] = "Botellero en Estiba Climatizada")
		formatString: $#,##0;($#,##0);"-"
		displayFolder: 03 Inventario Guarda y Mermas
		lineageTag: 47a2f2bf-0b73-445e-98b5-1c1ea1c46f51

	measure 'Litros Piletas Acero' = CALCULATE(SUM(fact_inventario_guarda[Litros]), fact_inventario_guarda[TipoVasija] = "Piletas de Acero Inoxidable")
		formatString: #,##0 "L"
		displayFolder: 03 Inventario Guarda y Mermas
		lineageTag: 8be809f9-f275-4802-93f0-72673778653b

	measure 'Litros Barricas Roble' = CALCULATE(SUM(fact_inventario_guarda[Litros]), fact_inventario_guarda[TipoVasija] IN {"Barricas de Roble Frances", "Barricas de Roble Americano"})
		formatString: #,##0 "L"
		displayFolder: 03 Inventario Guarda y Mermas
		lineageTag: 28970b22-e55c-4f77-8622-796120fbe658

	measure 'Litros Botellero Estiba' = CALCULATE(SUM(fact_inventario_guarda[Litros]), fact_inventario_guarda[TipoVasija] = "Botellero en Estiba Climatizada")
		formatString: #,##0 "L"
		displayFolder: 03 Inventario Guarda y Mermas
		lineageTag: 47a2f2bf-0b73-445e-98b5-1c1ea1c46f52

	measure 'DIO Rango Optimo' = 
			VAR _DIO = [DIO Promedio Dias]
			RETURN IF(_DIO <= 185, _DIO, 185)
		formatString: 0.0 "días"
		displayFolder: 03 Inventario Guarda y Mermas
		lineageTag: eca5752f-2cef-4dee-9337-f8946fbb2007

	measure 'DIO Desvio Exceso' = 
			VAR _DIO = [DIO Promedio Dias]
			RETURN IF(_DIO > 185, _DIO - 185, 0)
		formatString: 0.0 "días"
		displayFolder: 03 Inventario Guarda y Mermas
		lineageTag: eca5752f-2cef-4dee-9337-f8946fbb2008

	measure 'Costo Unitario Real Absorbido' = [Costo Unitario Real por Botella]
		formatString: $#,##0.00;($#,##0.00);"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: a43c9057-99c3-4f12-8035-7836fd873e2e

	measure 'Desvio Costo Unitario Fabril' = [Costo Unitario Real Absorbido] - [Costo Estandar Unitario]
		formatString: +$#,##0.00;-$#,##0.00;"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: 225133e4-7237-44d7-99fd-69fcbb05ec6f

	measure 'Capacidad Maxima Molienda Semanal' = DIVIDE([Total Kilos Uva], 9.088, 0)
		formatString: #,##0 "kg"
		displayFolder: 01 Eficiencia y Recepcion Vendimia
		lineageTag: d69c8f1e-b918-4d00-b043-b3fc5a5be5ec

	measure 'Porcentaje Utilizacion Capacidad Vendimia' = DIVIDE([Total Kilos Uva], [Capacidad Maxima Molienda Semanal] * 10, 0)
		formatString: 0.00%
		displayFolder: 01 Eficiencia y Recepcion Vendimia
		lineageTag: 9db32790-e1d6-4dc7-8f95-72d60236d980

	measure 'Costo Uva Ponderado por Kilo' = DIVIDE([Costo Elaboracion Total], [Total Kilos Uva], 0)
		formatString: $#,##0.00;($#,##0.00);"-"
		displayFolder: 02 Costos Fabriles y Absorcion
		lineageTag: dac8d639-bcf5-497a-a12a-a9fc2a655130

	measure 'Semaforo KPI' = 
		VAR _desvio = [Desvio Fabril %]
		RETURN
		    SWITCH(
		        TRUE(),
		        _desvio >= 0,               "CUMPLE",
		        _desvio >= -0.05,           "ALERTA",
		        "CRITICO"
		    )
		formatString: "@"
		displayFolder: 05 Diagnostico Causal
		lineageTag: 9b17ee49-c57f-49ad-b179-bad1aae6fdad

	measure 'Color Semaforo KPI' = 
		SWITCH(
		    [Semaforo KPI],
		    "CUMPLE",  "#065F46",
		    "ALERTA",  "#92400E",
		    "CRITICO", "#7F1D1D",
		    "#1E293B"
		)
		formatString: "@"
		displayFolder: 05 Diagnostico Causal
		lineageTag: e427f063-9a4c-499f-aa89-0de51bb03a3a

	measure 'Top Causa Desvio' = 
		VAR _tbl =
		    ADDCOLUMNS(
		        VALUES(fact_operaciones_planta[VariedadUva]),
		        "@desvio", ABS(CALCULATE([Desvio Fabril %]))
		    )
		VAR _top =
		    TOPN(1, _tbl, [@desvio], DESC)
		RETURN
		    CONCATENATEX(_top, fact_operaciones_planta[VariedadUva], ", ")
		formatString: "@"
		displayFolder: 05 Diagnostico Causal
		lineageTag: ee5cd885-4eca-4d50-9480-d920305c5d46

	measure 'Magnitud Desvio Top Causa' = 
		VAR _tbl =
		    ADDCOLUMNS(
		        VALUES(fact_operaciones_planta[VariedadUva]),
		        "@desvio", ABS(CALCULATE([Desvio Fabril %]))
		    )
		VAR _top =
		    TOPN(1, _tbl, [@desvio], DESC)
		RETURN
		    MAXX(_top, [@desvio])
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: 05 Diagnostico Causal
		lineageTag: 8cd53ee0-5dd9-4b7f-806f-0405c8ac62c6

	measure 'Diagnostico Causal' = 
		VAR _estado   = [Semaforo KPI]
		VAR _causa    = [Top Causa Desvio]
		VAR _magnitud = FORMAT([Magnitud Desvio Top Causa], "0.0%")
		VAR _real     = FORMAT([Costo Total Fabril], "$#,##0")
		VAR _ppto     = FORMAT([Costo Presupuesto Fabril], "$#,##0")
		RETURN
		    SWITCH(
		        _estado,
		        "CUMPLE",  "KPI en objetivo. " & _causa & " es el principal impulsor positivo (" & _magnitud & " s/ppto).",
		        "ALERTA",  "Desvio moderado. " & _causa & " concentra la mayor brecha (" & _magnitud & "). Real: " & _real & " | Ppto: " & _ppto & ".",
		        "CRITICO", "ACCION REQUERIDA: " & _causa & " presenta desvio critico (" & _magnitud & "). Real: " & _real & " vs Ppto: " & _ppto & "."
		    )
		formatString: "@"
		displayFolder: 05 Diagnostico Causal
		lineageTag: e7e6dfef-10e2-473d-b55a-58c024b11387

	measure 'Rank Desvio por Dimension' = 
		VAR _tbl = ADDCOLUMNS(VALUES(fact_operaciones_planta[VariedadUva]), "@dev", ABS(CALCULATE([Desvio Fabril %])))
		RETURN RANKX(_tbl, [@dev], , DESC, Skip)
		formatString: 0
		displayFolder: 05 Diagnostico Causal
		lineageTag: f5a0bb62-83d6-404d-8cc4-5c5ffe743a67

	measure 'KPI Fuera de Objetivo' = 
		IF([Desvio Fabril %] < -0.05, 1, 0)
		formatString: 0
		displayFolder: 05 Diagnostico Causal
		lineageTag: 6f803ad9-1ac5-4fbe-b3f5-e66850d8a39a

	measure 'Varianza Absoluta KPI' = [Costo Total Fabril] - [Costo Presupuesto Fabril]
		displayFolder: 05 Diagnostico Causal
		lineageTag: 32ab4f66-0ede-4d18-9415-8939353ca99a

	measure 'Periodo Seleccionado' = 
		VAR _anio = SELECTEDVALUE(dim_calendario[Anio], "Todos")
		VAR _mes  = SELECTEDVALUE(dim_calendario[MesNombre], "")
		RETURN
		    IF(_mes <> "", _anio & " — " & _mes, _anio & " (todos los meses)")
		formatString: "@"
		displayFolder: 06 Storytelling y Contexto
		lineageTag: 2226dc3c-917e-4eed-b632-96accb8792e3

	measure 'Titulo Dinamico Principal' = 
		"Evolucion " & [Total Kilos Uva] & " — " & [Periodo Seleccionado]
		formatString: "@"
		displayFolder: 06 Storytelling y Contexto
		lineageTag: 32dbbb65-cfa4-4f43-8c5d-9fe01648aa66

	measure 'Real Anio Anterior' = 
		CALCULATE([Total Kilos Uva], SAMEPERIODLASTYEAR(dim_calendario[Fecha]))
		displayFolder: 06 Storytelling y Contexto
		lineageTag: 551b8246-eb7b-4294-9edc-e27b981336ce

	measure 'Variacion YoY' = 
		DIVIDE([Total Kilos Uva] - [Real Anio Anterior], ABS([Real Anio Anterior]), BLANK())
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 06 Storytelling y Contexto
		lineageTag: 2279b5f2-bf93-49e6-ae89-2e508b7d70cf

	measure 'Variacion YoY Texto' = 
		VAR _yoy = [Variacion YoY]
		RETURN
		    IF(
		        ISBLANK(_yoy),
		        "Sin periodo anterior comparable",
		        IF(_yoy >= 0,
		            "+" & FORMAT(_yoy, "0.0%") & " vs. año anterior",
		            FORMAT(_yoy, "0.0%") & " vs. año anterior"
		        )
		    )
		formatString: "@"
		displayFolder: 06 Storytelling y Contexto
		lineageTag: 46949d83-7223-443c-b647-e19175084559

	measure 'Resumen Ejecutivo' = 
		VAR _estado   = [Semaforo KPI]
		VAR _dev      = FORMAT(ABS([Desvio Fabril %]), "0.0%")
		VAR _yoy      = [Variacion YoY Texto]
		VAR _causa    = [Top Causa Desvio]
		VAR _periodo  = [Periodo Seleccionado]
		RETURN
		    SWITCH(
		        _estado,
		        "CUMPLE",
		            "SITUACION: En objetivo para " & _periodo & ". " &
		            "El cumplimiento es positivo con " & _yoy & ". " &
		            "Impulsor principal: " & _causa & ".",
		        "ALERTA",
		            "ATENCION: Desvio moderado (" & _dev & " bajo plan) en " & _periodo & ". " &
		            _yoy & ". " &
		            "Revisar: " & _causa & ".",
		        "CRITICO",
		            "ACCION URGENTE: Desvio critico (" & _dev & " bajo plan) en " & _periodo & ". " &
		            _yoy & ". " &
		            "Dimension mas comprometida: " & _causa & ". Se requiere plan de recuperacion."
		    )
		formatString: "@"
		displayFolder: 06 Storytelling y Contexto
		lineageTag: 4bb62b86-383a-4ff7-abd6-efaa52a1dff2

	measure 'Tendencia YoY Icono' = 
		IF([Variacion YoY] >= 0, "▲", "▼")
		formatString: "@"
		displayFolder: 06 Storytelling y Contexto
		lineageTag: b38b3637-d34e-4b58-a262-58346df08400

	column Medidas
		dataType: string
		isHidden
		lineageTag: ca4762f0-dd5d-405a-b784-171442631b47
		summarizeBy: none
		isNameInferred
		sourceColumn: [Medidas]

		annotation SummarizationSetBy = Automatic

	partition _Medidas_Operaciones = calculated
		mode: import
		source = Row("Medidas", "Tabla de Medidas Operaciones y Planta")
