model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: es-AR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["RutaDatos","Calendario","CentrosCosto","Productos","PresupuestoVentas","Ventas","ElasticidadSegmento","EstacionalidadMensual","PronosticoDemanda","PrecisionModelo","TestsCointegracion"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Calendario
ref table CentrosCosto
ref table Productos
ref table PresupuestoVentas
ref table Ventas
ref table ElasticidadSegmento
ref table EstacionalidadMensual
ref table PronosticoDemanda
ref table PrecisionModelo
ref table TestsCointegracion
ref table _Medidas_Comercial
ref table _Medidas_Econometria

ref cultureInfo en-US

