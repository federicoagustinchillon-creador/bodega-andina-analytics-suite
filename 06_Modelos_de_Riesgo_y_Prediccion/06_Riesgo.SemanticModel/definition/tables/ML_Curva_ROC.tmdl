					Tipos = Table.TransformColumnTypes(ReemplazarInf, {{"Modelo", type text}, {"Threshold", type number}, {"FPR", type number}, {"TPR", type number}, {"Youden_J", type number}, {"EsPuntoOptimo", type logical}}, "en-US")
				in
					Tipos

