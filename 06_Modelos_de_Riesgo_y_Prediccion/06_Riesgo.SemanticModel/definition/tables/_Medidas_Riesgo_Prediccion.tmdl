	measure 'Semaforo Salud Cartera' =
			SWITCH(
				TRUE(),
				[Proporcion Cartera en Riesgo %] > 0.15, "🔴 ALTO RIESGO",
				[Proporcion Cartera en Riesgo %] > 0.08, "🟡 ALERTA",
